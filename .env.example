# 复制为 .env 后填写数据库配置
DB_HOST=您的MySQL服务器IP
DB_PORT=3306
DB_NAME=udi_devices
DB_USER=您的用户名
DB_PASSWORD=您的密码

# RSS 地址（通常不需要修改）
# RSS_DAILY_URL=https://udi.nmpa.gov.cn/rss/download.html?files=daily
# RSS_WEEKLY_URL=https://udi.nmpa.gov.cn/rss/download.html?files=weekly
# RSS_MONTHLY_URL=https://udi.nmpa.gov.cn/rss/download.html?files=monthly
# RSS_FULL_URL=https://udi.nmpa.gov.cn/rss/download.html?files=full

# 本地运行时可修改；容器运行时由 docker-compose 指定
# INBOX_DIR=inbox
# ARCHIVE_DIR=archive
# FAILED_DIR=failed
# DOWNLOAD_INTERVAL_HOURS=24
# IMPORT_POLL_SECONDS=60
