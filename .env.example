# ===========================================
# UDI医疗器械数据平台 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ===========================================

# 数据库配置（必填，不配置无法启动）
DB_HOST=您的MySQL服务器IP
DB_PORT=3306
DB_NAME=udi_devices
DB_USER=您的用户名
DB_PASSWORD=您的密码

# RSS配置（可选）
# RSS_DAILY_URL=https://udi.nmpa.gov.cn/rss/download.html?files=daily

# 时区（可选，默认东八区，影响日志时间）
# TZ=Asia/Shanghai
